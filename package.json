{
  "name": "@nithin93/sri-js",
  "version": "1.2.6",
  "description": "Subresource Integrity (SRI) for JavaScript: add integrity attributes to HTML script tags and to scripts created at runtime.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "build": "rimraf dist && tsc && tsc -p tsconfig.cjs.json && npm run build:browser",
    "build:browser": "esbuild src/client.ts --bundle --format=iife --global-name=SRIJS --outfile=public/sri-js.js --minify --target=es6",
    "test": "jest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./sri-js.js": "./public/sri-js.js",
    "./package.json": "./package.json",
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/cjs/browser.js"
    }
  },
  "keywords": [
    "subresource-integrity",
    "sri",
    "integrity",
    "sri-hash",
    "script-integrity",
    "security",
    "html",
    "script-tag",
    "sha384",
    "browser",
    "dynamic-script",
    "cdn",
    "typescript"
  ],
  "author": "Nithin Murali <nithintecharch@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nithin-murali-arch/sri-js"
  },
  "bugs": {
    "url": "https://github.com/nithin-murali-arch/sri-js/issues"
  },
  "homepage": "https://github.com/nithin-murali-arch/sri-js#readme",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "esbuild": "^0.20.1",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "cheerio": "^1.0.0-rc.12"
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
